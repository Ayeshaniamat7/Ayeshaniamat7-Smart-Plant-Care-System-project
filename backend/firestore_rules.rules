rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Plant Profiles Rules
    match /plants/{plantId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Live Sensor Readings (Devices)
    // Read: authenticated user who owns plant linked to device
    // Write: hardware node via admin SDK or anonymous hardware auth
    match /devices/{deviceId}/live/{document=**} {
      allow read: if isAuthenticated();
      allow write: if true; // Allowed for IoT Node data ingestion
    }
  }
}
